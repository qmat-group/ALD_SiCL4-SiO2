&CONTROL
  calculation = 'relax'
  etot_conv_thr =   7.7000000000d-04
  forc_conv_thr =   1.0000000000d-04
  dt = 1.0
  nstep = 100 
  outdir = './out/'
  prefix = 'aiida'
  pseudo_dir = './pseudo/'
  tprnfor = .true.
  tstress = .true.
  verbosity = 'high'
  restart_mode = 'from_scratch'
/
&SYSTEM
  degauss =   1.4699723600d-02
  ecutrho =   4.8000000000d+02
  ecutwfc =   6.0000000000d+01
  ibrav = 0
  nat = 5
  nosym = .true.
  ntyp = 4
  occupations = 'smearing'
  smearing = 'cold'
  vdw_corr='grimme-d2'
/
&ELECTRONS
  conv_thr =   1.5400000000d-08
  electron_maxstep = 80
  mixing_beta =   4.0000000000d-01
  scf_must_converge = .False.
/
&IONS
 ion_dynamics = 'bfgs'
/

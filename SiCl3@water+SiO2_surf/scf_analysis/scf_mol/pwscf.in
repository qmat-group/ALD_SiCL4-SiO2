&CONTROL
  calculation = 'scf'
  etot_conv_thr =   7.7000000000d-04
  forc_conv_thr =   1.0000000000d-04
  dt = 1.0
  nstep = 100 
  outdir = './out/'
  prefix = 'aiida'
  pseudo_dir = './pseudo/'
  tprnfor = .true.
  tstress = .true.
  verbosity = 'high'
  restart_mode = 'from_scratch'
/
